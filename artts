#!/usr/bin/env python3
"""
artts — Article-to-Speech pipeline
Reads articles through a local LLM (Ollama) + TTS (edge-tts) -> MP3.

Commands:
  setup                 Install Ollama, pull model, install Python deps
  read [input]          Article -> LLM rewrite -> TTS -> MP3
  voices                List edge-tts voices
  models                List installed Ollama models
"""

VERSION = "1.1.1"

import sys, os, json, urllib.request, subprocess, re, asyncio, time
from pathlib import Path
from html.parser import HTMLParser

# Config
OLLAMA_HOST = os.environ.get("OLLAMA_HOST", "http://localhost:11434")
CONFIG_DIR = Path.home() / ".config" / "artts"
CONFIG_FILE = CONFIG_DIR / "config.json"

DEFAULTS = {
    "llm": "qwen2.5:1.5b",
    "voice": "en-US-JennyNeural",
    "prompt": "Rewrite the following text as a natural, conversational audio script meant to be read aloud. Use clear, flowing language. Avoid markdown, bullet points, formatting symbols, or anything that doesn't read well. Keep it engaging and easy to follow by ear.",
}

# User-Agent that looks like a real browser
_UA = "Mozilla/5.0 (Linux; Android 15; Samsung Galaxy S25) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Mobile Safari/537.36"

# HTML -> text fallback
class _Strip(HTMLParser):
    def __init__(self):
        super().__init__()
        self.out, self.skip = [], False
    def handle_starttag(self, t, a):
        if t in ("script","style"): self.skip = True
    def handle_endtag(self, t):
        if t in ("script","style"): self.skip = False
        if t in ("p","br","div","h1","h2","h3","h4","h5","h6","li","tr","td","th"): self.out.append("\n")
    def handle_data(self, d):
        if not self.skip: self.out.append(d)

def _strip_html(html):
    s = _Strip(); s.feed(html); return "".join(s.out)

# Article extraction (trafilatura, with fallback)
_HAS_TRAFILATURA = False
try:
    import trafilatura
    _HAS_TRAFILATURA = True
except ImportError:
    pass

def _extract_article(url):
    if _HAS_TRAFILATURA:
        try:
            downloaded = trafilatura.fetch_url(url)
            if downloaded:
                text = trafilatura.extract(downloaded, output_format="txt",
                    include_links=False, include_images=False,
                    include_tables=False, include_formatting=False)
                if text and len(text.strip()) > 100:
                    return text.strip()
        except Exception:
            pass
    return None

def _fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": _UA})
    with urllib.request.urlopen(req, timeout=30) as r:
        return r.read().decode("utf-8","replace"), r.headers.get("Content-Type","")

# Shell helpers
def sh(cmd):
    print(f"  $ {cmd}", file=sys.stderr)
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    if r.returncode and r.stderr: print(r.stderr, file=sys.stderr)
    return r

def tip(msg):
    print(f"  {msg}", file=sys.stderr)

# Ollama
def _ollama_alive():
    try:
        req = urllib.request.Request(f"{OLLAMA_HOST}/api/tags", headers={"User-Agent": _UA})
        urllib.request.urlopen(req, timeout=2)
        return True
    except Exception:
        return False

def _ollama_start():
    tip("Starting Ollama server...")
    subprocess.Popen(["ollama","serve"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    for _ in range(20):
        if _ollama_alive(): return tip("OK")
        time.sleep(1.5)
    print("Could not start Ollama - run 'ollama serve' in another Termux session", file=sys.stderr)
    sys.exit(1)

def _ollama_req(method, path, data=None):
    url = f"{OLLAMA_HOST}/api/{path}"
    body = json.dumps(data).encode() if data else None
    r = urllib.request.Request(url, data=body, method=method,
        headers={"Content-Type":"application/json", "User-Agent": _UA})
    with urllib.request.urlopen(r) as resp:
        return json.loads(resp.read())

def ollama_call(model, prompt):
    r = _ollama_req("POST", "generate", {"model":model,"prompt":prompt,"stream":False,"options":{"num_predict":8192}})
    return r.get("response","").strip()

def ollama_models():
    if not _ollama_alive(): return []
    return [m["name"] for m in _ollama_req("GET","tags").get("models",[])]

def ollama_pull(name):
    tip(f"Pulling {name} ...")
    _ollama_req("POST", "pull", {"name":name})
    tip("OK")

# TTS
def _check_edge():
    try:
        import edge_tts
        return True
    except ImportError:
        return False

async def _tts(text, voice, path):
    import edge_tts
    c = edge_tts.Communicate(text, voice)
    await c.save(str(path))

def do_tts(text, voice, path):
    asyncio.run(_tts(text, voice, path))

async def _list_voices():
    import edge_tts
    for v in sorted(await edge_tts.list_voices(), key=lambda x: x["ShortName"]):
        print(f"{v['ShortName']:40s} {v['Gender']:6s} {v['Locale']}")

# Input reading
def read_source(src):
    if src.startswith(("http://","https://")):
        tip(f"Fetching {src} ...")
        text = _extract_article(src)
        if text:
            tip(f"  extracted {len(text)} chars of article text")
            return text
        tip("  article extraction failed, falling back to raw HTML strip")
        try:
            data, ct = _fetch(src)
        except urllib.error.HTTPError as e:
            print(f"HTTP error {e.code}: {e.reason}", file=sys.stderr)
            print("Try saving the article to a .txt file and using: artts read file.txt", file=sys.stderr)
            sys.exit(1)
        if "html" in ct or "html" in data[:500].lower():
            return _strip_html(data)
        return data
    p = Path(src)
    if not p.exists():
        print(f"File not found: {src}", file=sys.stderr); sys.exit(1)
    return p.read_text("utf-8","replace")

# Commands
def cmd_setup(args):
    tip("Setting up artts ...")
    if sh("which ollama").returncode:
        tip("Installing Ollama ...")
        sh("pkg install tur-repo -y")
        sh("pkg install ollama -y")
    else:
        tip("Ollama already installed")
    if not _ollama_alive(): _ollama_start()
    models = args.models or [DEFAULTS["llm"]]
    for m in models:
        if m not in ollama_models():
            ollama_pull(m)
        else:
            tip(f"{m} already pulled")
    tip("Installing Python packages (edge-tts, trafilatura) ...")
    sh("pip install edge-tts trafilatura")
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    cfg = dict(DEFAULTS)
    if args.default_llm: cfg["llm"] = args.default_llm
    if args.default_voice: cfg["voice"] = args.default_voice
    CONFIG_FILE.write_text(json.dumps(cfg, indent=2))
    tip("Setup complete!")

def cmd_read(args):
    cfg = dict(DEFAULTS)
    if CONFIG_FILE.exists():
        cfg.update(json.loads(CONFIG_FILE.read_text()))
    model = args.model or cfg["llm"]
    voice = args.voice or cfg["voice"]
    prompt_tpl = args.prompt or cfg["prompt"]
    output = args.output
    if args.input:
        if args.input.startswith(("http://","https://")):
            text = read_source(args.input)
            stem = re.sub(r"[^a-zA-Z0-9]+","_", args.input.split("/")[-1].split(".")[0] or "article")
        elif args.input == "-":
            text = sys.stdin.read(); stem = "stdin"
        else:
            text = read_source(args.input); stem = Path(args.input).stem
    else:
        text = sys.stdin.read(); stem = "stdin"
    if not text.strip():
        print("No input text", file=sys.stderr); sys.exit(1)
    if not output: output = f"{stem}.mp3"
    tip(f"Input: {len(text)} chars")
    if not args.direct:
        if not _ollama_alive(): _ollama_start()
        tip(f"LLM ({model}) rewriting for speech ...")
        if len(text) > 12000: text = text[:12000] + "\n\n[... truncated ...]"
        tts_text = ollama_call(model, f"{prompt_tpl}\n\n---\n\n{text}")
        tip(f"   -> {len(tts_text)} chars")
    else:
        tts_text = text
    if not _check_edge():
        print("edge-tts not installed - run 'artts setup' first", file=sys.stderr); sys.exit(1)
    tip(f"TTS ({voice}) -> {output} ...")
    do_tts(tts_text, voice, output)
    sz = Path(output).stat().st_size
    tip(f"Saved: {output} ({sz/1024:.0f} KB, ~{sz/1024/16:.1f} min)")

def cmd_voices():
    if not _check_edge(): print("edge-tts not installed - run 'artts setup' first", file=sys.stderr); sys.exit(1)
    asyncio.run(_list_voices())

def cmd_models():
    if not _ollama_alive(): _ollama_start()
    for m in ollama_models(): print(m)

def main():
    import argparse
    p = argparse.ArgumentParser(prog="artts", description="Article -> LLM -> TTS -> MP3")
    p.add_argument("command", nargs="?", default="read", choices=["setup","read","voices","models"])
    args, rest = p.parse_known_args()
    if args.command == "setup":
        sp = argparse.ArgumentParser()
        sp.add_argument("--models", nargs="*"); sp.add_argument("--default-llm"); sp.add_argument("--default-voice")
        cmd_setup(sp.parse_args(rest))
    elif args.command == "read":
        sp = argparse.ArgumentParser()
        sp.add_argument("input", nargs="?"); sp.add_argument("-m","--model"); sp.add_argument("-v","--voice")
        sp.add_argument("-o","--output"); sp.add_argument("-p","--prompt"); sp.add_argument("-d","--direct", action="store_true")
        cmd_read(sp.parse_args(rest))
    elif args.command == "voices": cmd_voices()
    elif args.command == "models": cmd_models()

if __name__ == "__main__":
    main()
